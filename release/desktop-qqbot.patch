+
+async function saveAndStartMatch() {
+  const referee = validateRefereeForm();
+  if (!referee) return;
+  const button = document.getElementById('saveAndStartMatchBtn');
+  button.disabled = true;
+  button.textContent = '正在发送...';
+  showMatchStartError('');
+  saveRefereeInfo(referee.room, referee.title);
+
+  pendingMatchPayload ||= { ...buildMatchStartPayload(referee.room, referee.title), scores: currentMatchScores() };
+  const payload = pendingMatchPayload;
+  try { localStorage.setItem('bingotools_pending_start', JSON.stringify({ key: matchIdempotencyKey, payload })); } catch(e) {}
+  clearInterval(stopwatchInterval); stopwatchRunning = false;
+  stopwatchSeconds = Math.max(0, Math.floor((Date.now() - Date.parse(payload.started_at)) / 1000));
+  startStopwatch(); updateStopwatchDisplay();
+  try {
+    const result = await callQQBot('/api/v1/matches/start', payload, { idempotencyKey: matchIdempotencyKey });
+    setMatchStarted(payload.started_at, result.match_id);
+    pendingMatchPayload = null;
+    localStorage.removeItem('bingotools_pending_start');
+    hideMatchStartModal();
+    showToast('比赛已开始，计时器已启动，已发送到 QQ 群');
+  } catch(e) {
+    pauseStopwatch();
+    if ([400, 401, 403].includes(e.status)) {
+      pendingMatchPayload = null;
+      try { localStorage.removeItem('bingotools_pending_start'); } catch (_) {}
+    }
+    showMatchStartError('QQ 播报失败：' + e.message + '。请先核对 QQ 群，也可选择仅本地开始。');
+    document.getElementById('startLocalOnlyBtn').classList.remove('hide');
+  } finally {
+    button.disabled = false;
+    button.textContent = '保存并开始';
+  }
+}
