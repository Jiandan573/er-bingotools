+  return {
+    serviceUrl: String(saved.serviceUrl || QQ_BOT_CONFIG.serviceUrl || '').trim().replace(/\/+$/, ''),
+    clientKey: String(saved.clientKey || QQ_BOT_CONFIG.clientKey || '').trim()
