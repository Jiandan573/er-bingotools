+
+function saveQQBotConfig() {
+  const serviceUrl = document.getElementById('qqBotServiceUrl').value.trim().replace(/\/+$/, '');
+  const clientKey = document.getElementById('qqBotClientKey').value.trim();
+  if (!serviceUrl) {
+    showToast('请输入 QQ Bot 服务地址');
+    return;
+  }
+  try {
+    const url = new URL(serviceUrl);
+    if (url.protocol !== 'http:' && url.protocol !== 'https:') throw new Error('invalid protocol');
+  } catch (e) {
+    showToast('QQ Bot 服务地址格式不正确');
+    return;
+  }
+  if (!clientKey) {
+    showToast('请输入 QQ Bot 客户端密钥');
+    return;
+  }
+  try {
+    localStorage.setItem(QQ_BOT_CONFIG_KEY, JSON.stringify({ serviceUrl, clientKey }));
+  } catch (e) {
+    showToast('QQ Bot 配置保存失败');
+    return;
+  }
+  showToast('QQ Bot 服务配置已保存');
+}
+
+async function callQQBot(path, body, options = {}) {
+  const config = getQQBotConfig();
+  if (!config.serviceUrl) throw new Error('请先配置 QQ Bot 服务地址');
+  if (!config.clientKey) throw new Error('请先配置 QQ Bot 客户端密钥');
+
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 90000);
+  try {
+    let response;
+    const nativeBot = window.go?.app?.App?.CallQQBot;
+    if (typeof nativeBot === 'function') {
+      const result = await nativeBot(config.serviceUrl, config.clientKey, path, JSON.stringify(body || {}), options.idempotencyKey || '');
+      response = { ok: result.status >= 200 && result.status < 300, status: result.status, text: async () => result.body };
+    } else {
+      response = await fetch(config.serviceUrl + path, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: 'Bearer ' + config.clientKey,
+        ...(options.idempotencyKey ? { 'Idempotency-Key': options.idempotencyKey } : {})
+      },
+      body: body == null ? undefined : JSON.stringify(body),
+      signal: controller.signal
+      });
+    }
+    const raw = await response.text();
+    let data = {};
+    try { data = raw ? JSON.parse(raw) : {}; } catch (e) { data = { error: raw }; }
+    if (!response.ok || data.ok === false) {
+      throw Object.assign(new Error(data.error || data.message || `服务请求失败（${response.status}）`), { status: response.status });
+    }
+    return data;
+  } catch (e) {
+    if (e && e.name === 'AbortError') throw new Error('等待服务超过 90 秒；免费服务可能正在启动。若已提交播报，请先查看 QQ 群确认是否收到，避免重复发送');
+    if (e instanceof TypeError && /fetch|network|load failed/i.test(e.message)) {
+      throw new Error('无法连接 QQ Bot 服务，请检查 Render 地址和网络；直接打开 HTML 时，服务需允许本地文件来源（null）。');
+    }
+    throw e;
+  } finally {
+    clearTimeout(timeout);
+  }
+}
